# Copy to backend/.env when running the backend outside Docker.
TRAVELRAG_DATABASE_URL=postgresql+psycopg://travelrag:travelrag@localhost:5432/travelrag
TRAVELRAG_JWT_SECRET=dev-only-insecure-secret-change-me-32b
TRAVELRAG_LOG_LEVEL=INFO

# Disposable database used by integration tests (created by docker compose).
TRAVELRAG_TEST_DATABASE_URL=postgresql+psycopg://travelrag:travelrag@localhost:5432/travelrag_test
